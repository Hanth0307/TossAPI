# Copy this file to `.env` and fill in real values locally.
# NEVER commit `.env` - it is already excluded via .gitignore.

# --- Runtime environment ---
# dev | test | prod  (tests force APP_ENV=test automatically, see tests/conftest.py)
APP_ENV=dev
LOG_LEVEL=INFO
# json (machine-readable, for log aggregation) | console (human-readable, local dev)
LOG_FORMAT=console

# --- PostgreSQL (optional, wired up in a later phase) ---
DATABASE_URL=postgresql://quant:quant@localhost:5432/quant

# --- Toss Investment Open API ---
# Obtain these from the Toss Securities developer portal.
# Do NOT assume a base URL or response field names here - verify
# against the official API docs before any adapter depends on them.
TOSS_API_BASE_URL=
TOSS_API_KEY=
TOSS_API_SECRET=

# --- Outbound HTTP defaults (read-only / non-order calls) ---
# Order-mutating calls use a separate, non-retrying policy - see
# docs/architecture/0004-external-api-timeout-retry-policy.md
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3

# --- Safety switch ---
# Must stay true until a real live-broker adapter is implemented and
# explicitly reviewed. Phase 00 ships no order-placing code at all.
PAPER_TRADING_ONLY=true

# Copy this file to `.env` and fill in real values locally.
# NEVER commit `.env` - it is already excluded via .gitignore.

# --- Runtime environment ---
# dev | test | prod  (tests force APP_ENV=test automatically, see tests/conftest.py)
APP_ENV=dev
LOG_LEVEL=INFO
# json (machine-readable, for log aggregation) | console (human-readable, local dev)
LOG_FORMAT=console

# --- PostgreSQL (optional, wired up in a later phase) ---
DATABASE_URL=postgresql://quant:quant@localhost:5432/quant

# --- Toss Open API (OAuth 2.0 Client Credentials Grant) ---
# Obtain these from the Toss Securities Open API developer portal.
# TOSS_API_BASE_URL defaults to the confirmed official base URL below
# and normally does not need to be overridden.
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# X-Tossinvest-Account header value for account/asset/order-read
# calls (see app/toss/). Required only if you need PortfolioReadAdapter.
TOSS_ACCOUNT_SEQ=

# --- Outbound HTTP defaults (read-only / non-order calls) ---
# Order-mutating calls use a separate, non-retrying policy - see
# docs/architecture/0004-external-api-timeout-retry-policy.md
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3

# --- Safety switches ---
# Must stay true until a real live-broker adapter is implemented and
# explicitly reviewed. Phase 00 ships no order-placing code at all.
PAPER_TRADING_ONLY=true
# Code-level gate for the Toss adapters (app/toss/) - must stay true.
# Phase 02 ships no order-placing code at all; see ADR 0007.
TOSS_READ_ONLY_MODE=true
